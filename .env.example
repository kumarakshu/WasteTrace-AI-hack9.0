# WasteTrace AI - Environment Configuration
PROJECT_NAME="WasteTrace AI"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration (SQLite default for zero-dependency local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./wastetrace.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/wastetrace_ai"

# Upload Storage Directory
UPLOAD_DIR="./backend/uploads"

# Optional External AI Vision API Key (Google Gemini)
# If left blank, the application automatically uses the offline heuristic vision analyzer
GEMINI_API_KEY=""

# Recurrence Detection Defaults
DEFAULT_RECURRENCE_RADIUS_METERS=50.0
DEFAULT_RECURRENCE_WINDOW_DAYS=14
DEFAULT_FOLLOW_UP_WINDOW_DAYS=30

# Explainable Priority Weights (Must sum to 1.00)
WEIGHT_SEVERITY=0.40
WEIGHT_RECURRENCE=0.30
WEIGHT_DURATION=0.20
WEIGHT_EVIDENCE=0.10

